# Copie para .env (nunca commite o .env)
#   Copy-Item .env.example .env

# --- Banco local (Docker Compose) ---
POSTGRES_DB=renmember
POSTGRES_USER=renmember
POSTGRES_PASSWORD=renmember_dev
POSTGRES_PORT=5432

# --- API ---
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080
ConnectionStrings__Renmember=Host=db;Port=5432;Database=renmember;Username=renmember;Password=renmember_dev

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Usuário ---
USER_TIMEZONE=America/Sao_Paulo
