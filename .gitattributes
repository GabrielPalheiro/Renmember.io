# Normaliza tudo para LF no repositório e na cópia de trabalho
* text=auto eol=lf

# Scripts do Windows mantêm CRLF para rodar sem surpresas
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binários
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
